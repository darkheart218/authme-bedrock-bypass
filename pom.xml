<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>authme-bedrock-bypass</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <!--
            PENTING: pakai "release" (bukan source/target terpisah) di-set ke versi PALING RENDAH
            yang mau didukung, yaitu 17. Java itu mundur-kompatibel: hasil compile dengan release=17
            otomatis BISA jalan di server yang pakai Java 17, 21, ataupun 26 tanpa perlu bikin
            build terpisah untuk tiap versi.
            Jangan set angka ini ke 21 atau 26, karena nanti jar-nya JADI TIDAK BISA jalan di
            server yang masih pakai Java 17.
        -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- Repo untuk Paper/Spigot API -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- Repo untuk Floodgate -->
        <repository>
            <id>opencollab-snapshot</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
        <!-- Repo RESMI AuthMe (bukan Jitpack lagi, AuthMe versi baru punya server Maven sendiri) -->
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.org/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spigot/Paper API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.20.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Floodgate API (untuk deteksi player Bedrock) -->
        <dependency>
            <groupId>org.geysermc.floodgate</groupId>
            <artifactId>api</artifactId>
            <version>2.2.3-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- AuthMe API (untuk force login). AuthMe versi baru (6.x) pakai nama package
             fr.xephi:authme-core, didownload dari repo resmi codemc (bukan Jitpack lagi). -->
        <dependency>
            <groupId>fr.xephi</groupId>
            <artifactId>authme-core</artifactId>
            <version>6.0.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
